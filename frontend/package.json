{
  "name": "vietaxlegal-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,jsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,jsx,json,md}\"",
    "check": "npm run test && npm run lint && npm run format:check && npm run build",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.5",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
