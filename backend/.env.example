APP_ENV=development
# Local PostgreSQL. URL-encode special characters in the password (@ : / % etc.).
DATABASE_URL=postgresql+psycopg://vietaxlegal:YOUR_URL_ENCODED_DB_PASSWORD@localhost:5432/vietaxlegal
# Supabase alternative: Dashboard -> Connect -> Session pooler, then append ?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=vietaxlegal_session
CORS_ORIGINS=http://localhost:3000
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
# To use OpenAI instead: CHAT_PROVIDER=openai and CHAT_MODEL=gpt-5.6-luna
CHAT_MAX_OUTPUT_TOKENS=1500
CHAT_HISTORY_MESSAGES=20
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_DAILY_MESSAGE_LIMIT=100
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
