APP_ENV=development
# Supabase Dashboard -> Connect -> Session pooler (recommended for IPv4 development machines).
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=vietaxlegal_session
CORS_ORIGINS=http://localhost:3000
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
# To use OpenAI instead: CHAT_PROVIDER=openai and CHAT_MODEL=gpt-5.6-luna
CHAT_MAX_OUTPUT_TOKENS=1500
CHAT_HISTORY_MESSAGES=20
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_DAILY_MESSAGE_LIMIT=100
