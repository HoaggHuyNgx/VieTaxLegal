APP_ENV=development
# Supabase Postgres: Dashboard -> Connect -> Direct -> Connection Method "Session pooler" (port 5432).
# Not "Direct connection" (IPv6 only) nor "Transaction pooler" (6543). sslmode=require is added for you.
# URL-encode special characters in the password (@ : / % etc.).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=vietaxlegal_session
REFRESH_COOKIE_NAME=vietaxlegal_refresh
# Access JWT lifetime; refresh token lives SESSION_TOKEN_HOURS (24) or REMEMBER_ME_DAYS (30).
ACCESS_TOKEN_MINUTES=15
REGISTER_MAX_PER_HOUR=10
CORS_ORIGINS=http://localhost:3000
# DEBUG | INFO | WARNING | ERROR. LOG_JSON=true prints one JSON object per line (for Docker/collectors).
LOG_LEVEL=INFO
LOG_JSON=false
CHAT_PROVIDER=anthropic
CHAT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
OPENAI_API_KEY=replace-with-your-openai-api-key
# To use OpenAI instead: CHAT_PROVIDER=openai and CHAT_MODEL=gpt-6-luna
CHAT_MAX_OUTPUT_TOKENS=1500
CHAT_HISTORY_MESSAGES=20
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_DAILY_MESSAGE_LIMIT=100
# RAG (not wired yet). Start Qdrant with scripts/start-qdrant.ps1.
RAG_ENABLED=false
RAG_CHUNK_SET=article
RAG_TOP_K=5
# dense | hybrid (hybrid needs the sparse vectors: scripts/backfill_sparse.py)
RAG_RETRIEVAL_MODE=hybrid
# Drop hits below this cosine score (0 = keep all); tune with the eval set.
RAG_MIN_SIMILARITY=0
# Return only documents marked in_force in corpus/manifest.json (set false only for local dev).
RAG_REQUIRE_IN_FORCE=true
QDRANT_URL=http://127.0.0.1:6333
# Leave empty for local Qdrant; set only for a non-local server.
QDRANT_API_KEY=
# openai (primary, uses OPENAI_API_KEY) | bkai (local CPU, needs the [local-embed] extra) | fake (tests)
# Model that writes eval questions (scripts/eval_generate.py). Blank = CHAT_MODEL.
EVAL_GENERATOR_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Optional (OpenAI only): shorten vectors. Leave empty for the model default.
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=64
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# Google sign-in is off until both are set (Google Cloud Console -> OAuth client, type Web application).
# The redirect URI must be registered there exactly as written below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
# Registration by password mails a 6-digit code first; without SMTP_HOST it is switched off.
# Gmail: turn on 2-step verification, create an App password, use smtp.gmail.com / 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
